# npm run setup creates a local admin password and session secret automatically.
ADMIN_PASSWORD=
SESSION_SECRET=
# Optional absolute path; defaults to ./data. Keep outside public/.
HIGO_DATA_DIR=
# Only enable when serving this local application over HTTPS.
HIGO_HTTPS=false

# Optional read-only atlas catalogue; defaults to HIGO_DATA_DIR/atlas.sqlite.
HIGO_ATLAS_PATH=

# npm run setup creates a local admin password and session secret automatically.
ADMIN_PASSWORD=
SESSION_SECRET=
# Optional absolute path; defaults to ./data. Keep outside public/.
HIGO_DATA_DIR=
# Only enable when serving this local application over HTTPS.
HIGO_HTTPS=false

# Optional read-only atlas catalogue; defaults to HIGO_DATA_DIR/atlas.sqlite.
HIGO_ATLAS_PATH=

# New submissions: local (default) or drive. Existing local photos remain local.
HIGO_PHOTO_STORAGE=local
# Populate privately in .env.local. Run npm run drive:connect for personal Drive.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=

    "iron-session": "^8.0.4",
    "maplibre-gl": "^6.16.0",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "shapefile": "^0.6.6",
    "sharp": "^0.35.5",
    "vt-pbf": "^3.1.3"
  },
  "overrides": {
    "sharp": "$sharp"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/geojson-vt": "^3.2.5",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/shapefile": "^0.6.4",
    "@types/topojson-client": "^3.1.5",
    "@types/vt-pbf": "^3.1.1",
    "topojson-client": "^3.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "world-atlas": "^2.0.2"
  }
